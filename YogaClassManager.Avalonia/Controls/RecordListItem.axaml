<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:controls="using:YogaClassManager.Avalonia.Controls"
             x:Class="YogaClassManager.Avalonia.Controls.RecordListItem"
             x:Name="Control">

    <StackPanel Margin="8,4">
        <!-- Grid, not a horizontal StackPanel: the master column is a fixed 320px, and only a starred
             column makes the title actually trim instead of running under the flag. -->
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding Title, ElementName=Control}"
                       FontWeight="{StaticResource FontWeightMedium}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <controls:Tag Grid.Column="1" Margin="8,0,0,0"
                          Color="{Binding FlagColor, ElementName=Control}"
                          Label="{Binding FlagLabel, ElementName=Control}"
                          IsVisible="{Binding IsFlagged, ElementName=Control}" />
        </Grid>

        <TextBlock Text="{Binding Subtitle, ElementName=Control}" Classes="Caption"
                   TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding Subtitle, ElementName=Control, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

</UserControl>
