<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:localConv="using:YogaClassManager.Avalonia.Converters"
             xmlns:controls="using:YogaClassManager.Avalonia.Controls"
             xmlns:data="using:YogaClassManager.Core.Data"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="YogaClassManager.Avalonia.Controls.SortByButton"
             x:Name="Control">

    <!-- "↑/↓ field" - clicking opens a small Flyout with the field dropdown and an
         ascending/descending radio pair, instead of inline ComboBoxes sitting in a filter bar. The
         standard way to expose sort for any repository-backed list (see UI_STYLE_GUIDE.md) - only
         omit this control where the filter's sort enum has no field beyond its internal fallback key
         (e.g. today's PassSortOptions, which is Id-only). -->
    <Button IsVisible="{Binding SortOptions, ElementName=Control, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
            AutomationProperties.Name="{Binding SortDescription, ElementName=Control}"
            ToolTip.Tip="{Binding SortDescription, ElementName=Control}">
        <StackPanel Orientation="Horizontal" Spacing="4">
            <!-- Direction arrow first, then just the field ("Last Attendance") - no "Sort by:" prefix;
                 SortDescription (tooltip/accessible name) still says "Sort by Last Attendance,
                 ascending" in full. Field labels come straight from the sort enum ("LastAttendance");
                 EnumDisplayTextConverter spaces them out here, in the dropdown and in SortDescription. -->
            <materialIcons:MaterialIcon Kind="ArrowUp" Width="14" Height="14" VerticalAlignment="Center"
                IsVisible="{Binding SelectedSortOrder, ElementName=Control, Converter={x:Static localConv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static data:Order.Ascending}}" />
            <materialIcons:MaterialIcon Kind="ArrowDown" Width="14" Height="14" VerticalAlignment="Center"
                IsVisible="{Binding SelectedSortOrder, ElementName=Control, Converter={x:Static localConv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static data:Order.Descending}}" />
            <TextBlock Text="{Binding SelectedSort, ElementName=Control, Converter={x:Static localConv:EnumDisplayTextConverter.Instance}}" />
        </StackPanel>
        <Button.Flyout>
            <controls:FadeFlyout Placement="BottomEdgeAlignedRight">
                <controls:SortOptionsPanel MinWidth="200"
                    SortOptions="{Binding SortOptions, ElementName=Control}"
                    SelectedSort="{Binding SelectedSort, ElementName=Control, Mode=TwoWay}"
                    SortOrderOptions="{Binding SortOrderOptions, ElementName=Control}"
                    SelectedSortOrder="{Binding SelectedSortOrder, ElementName=Control, Mode=TwoWay}" />
            </controls:FadeFlyout>
        </Button.Flyout>
    </Button>

</UserControl>
