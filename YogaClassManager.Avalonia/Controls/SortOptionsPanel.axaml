<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:localConv="using:YogaClassManager.Avalonia.Converters"
             xmlns:data="using:YogaClassManager.Core.Data"
             x:Class="YogaClassManager.Avalonia.Controls.SortOptionsPanel"
             x:Name="Control">

    <!-- The "Sort by" field dropdown + Ascending/Descending pair. Shared by SortByButton's flyout (detail
         pane lists) and FilterButton's flyout (a page's main list, where sort lives inside the one
         sort-and-filter popup), so the two can't drift apart. -->
    <StackPanel Spacing="8">
        <!-- Same heading style as the popup's "Filters" heading; Margin 0 so the panel's 8px spacing is
             the only gap below it (DialogTitle's own bottom margin would double it). -->
        <TextBlock Text="Sort by" Classes="DialogTitle" Margin="0" />
        <ComboBox ItemsSource="{Binding SortOptions, ElementName=Control}"
                  SelectedItem="{Binding SelectedSort, ElementName=Control, Mode=TwoWay}"
                  AutomationProperties.Name="Sort by"
                  HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={x:Static localConv:EnumDisplayTextConverter.Instance}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0"
                    IsVisible="{Binding SortOrderOptions, ElementName=Control, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <!-- No explicit GroupName - Avalonia groups same-parent RadioButtons by default, which
                 already scopes these two correctly per panel instance. A literal GroupName string
                 would risk cross-grouping if two instances of this panel were ever visible at once. -->
            <RadioButton Content="Ascending"
                IsChecked="{Binding SelectedSortOrder, ElementName=Control, Converter={x:Static localConv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static data:Order.Ascending}}" />
            <RadioButton Content="Descending"
                IsChecked="{Binding SelectedSortOrder, ElementName=Control, Converter={x:Static localConv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static data:Order.Descending}}" />
        </StackPanel>
    </StackPanel>

</UserControl>
