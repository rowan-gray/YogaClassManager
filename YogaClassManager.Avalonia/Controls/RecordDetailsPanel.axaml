<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YogaClassManager.Avalonia.Controls.RecordDetailsPanel"
             x:Name="Control">

    <ContentControl Content="{Binding Record, ElementName=Control}"
                    ContentTemplate="{Binding RecordTemplate, ElementName=Control}" />

</UserControl>
