<reactiveui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YogaClassManager.Avalonia.ViewModels.Identities"
             xmlns:people="using:YogaClassManager.Core.Models.People"
             xmlns:controls="using:YogaClassManager.Avalonia.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:reactiveui="clr-namespace:Avalonia.ReactiveUI;assembly=Avalonia.ReactiveUI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="YogaClassManager.Avalonia.Views.Identities.IdentitiesView"
             x:TypeArguments="vm:IdentitiesViewModel"
             x:Name="Root">

    <Grid RowDefinitions="Auto,*" Margin="{StaticResource PagePadding}">
        <TextBlock Grid.Row="0" Text="Identities" Classes="PageTitle" Margin="0,0,0,16" />

        <controls:MasterDetailView Grid.Row="1" Items="{Binding Items}" SelectedItem="{Binding Selection}"
                                   IsBusy="{Binding IsBusy}" ErrorText="{Binding LastError}"
                                   EmptyText="No identities match the current search and filters."
                                   NoSelectionText="Select an identity to view their details.">
            <controls:MasterDetailView.ListHeader>
                <controls:FilterBar SearchQuery="{Binding SearchQuery, Mode=TwoWay}"
                                     SearchWatermark="Search by name..."
                                     SortOptions="{Binding SortByOptions}" SelectedSort="{Binding SortBy, Mode=TwoWay}"
                                     SortOrderOptions="{Binding SortOrderOptions}"
                                     SelectedSortOrder="{Binding SortOrder, Mode=TwoWay}"
                                     FilterCount="{Binding ActiveFilterCount}"
                                     ClearFiltersCommand="{Binding ClearFiltersCommand}">
                    <controls:FilterBar.AdvancedFilters>
                        <CheckBox Content="Show archived" IsChecked="{Binding IncludeArchived}" />
                    </controls:FilterBar.AdvancedFilters>
                    <controls:FilterBar.Action>
                        <Button Command="{Binding AddIdentityCommand}" Classes="accent Icon"
                                AutomationProperties.Name="Add identity" ToolTip.Tip="Add identity">
                            <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18" />
                        </Button>
                    </controls:FilterBar.Action>
                </controls:FilterBar>
            </controls:MasterDetailView.ListHeader>

            <controls:MasterDetailView.ListItemTemplate>
                <DataTemplate DataType="people:Identity">
                    <controls:RecordListItem Title="{Binding FullName}" Subtitle="{Binding Email}"
                                             FlagLabel="ARCHIVED" IsFlagged="{Binding !IsActive}"
                                             FlagColor="{DynamicResource TagArchivedBrush}" />
                </DataTemplate>
            </controls:MasterDetailView.ListItemTemplate>

            <controls:MasterDetailView.DetailTemplate>
                <DataTemplate DataType="people:Identity">
                    <StackPanel Spacing="{StaticResource SpacingMd}">
                        <controls:RecordDetailsPanel Record="{Binding}">
                            <controls:RecordDetailsPanel.RecordTemplate>
                                <DataTemplate DataType="people:Identity">
                                    <StackPanel Spacing="{StaticResource SpacingXs}">
                                        <controls:DetailHeader Title="{Binding FullName}" PrimaryActionLabel="Edit" PrimaryActionIcon="Pencil"
                                                PrimaryActionCommand="{Binding DataContext.EditIdentityCommand, ElementName=Root}">
                                            <controls:DetailHeader.Actions>
                                                <Button Classes="Overflow">
                                                    <Button.Flyout>
                                                        <controls:FadeMenuFlyout Placement="BottomEdgeAlignedRight">
                                                            <MenuItem Header="Merge duplicate into this..."
                                                                      Command="{Binding DataContext.MergeDuplicatesCommand, ElementName=Root}" />
                                                            <MenuItem Header="Archive" IsVisible="{Binding IsActive}"
                                                                      Command="{Binding DataContext.ToggleArchiveCommand, ElementName=Root}" />
                                                            <MenuItem Header="Unarchive" IsVisible="{Binding !IsActive}"
                                                                      Command="{Binding DataContext.ToggleArchiveCommand, ElementName=Root}" />
                                                        </controls:FadeMenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </controls:DetailHeader.Actions>
                                        </controls:DetailHeader>
                                        <!-- A missing value still gets its line, with a Muted "n/a", so the
                                             label never disappears and shifts the rows below it. -->
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                            <TextBlock Text="Phone:" />
                                            <TextBlock Text="{Binding PhoneNumber}"
                                                       IsVisible="{Binding PhoneNumber, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                            <TextBlock Text="n/a" Classes="Muted"
                                                       IsVisible="{Binding PhoneNumber, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                            <TextBlock Text="Email:" />
                                            <TextBlock Text="{Binding Email}"
                                                       IsVisible="{Binding Email, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                            <TextBlock Text="n/a" Classes="Muted"
                                                       IsVisible="{Binding Email, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                                        </StackPanel>
                                        <TextBlock Text="Archived" Foreground="{DynamicResource StatusArchivedBrush}"
                                                   IsVisible="{Binding !IsActive}" />
                                    </StackPanel>
                                </DataTemplate>
                            </controls:RecordDetailsPanel.RecordTemplate>
                        </controls:RecordDetailsPanel>

                        <!-- Skeleton for the Student / Emergency contact for cards while this identity's
                             links load (including the selection debounce): which of the two will appear
                             isn't known yet, so one placeholder in the same shape - a heading bar and a
                             name-link bar - stands in for both. The real cards are hidden meanwhile
                             (their data is cleared the moment the selection changes).
                             Each bar sits over an invisible copy of the real control it stands in for (a
                             Caption TextBlock, a RecordLink Button), which sizes the row - so the card is
                             exactly as tall as the real one whatever the font metrics, instead of fixed bar
                             heights that came out a few pixels short. The copies are inert: not focusable,
                             not hit-testable and hidden from screen readers. -->
                        <Border Classes="Card" IsVisible="{Binding DataContext.IsLoadingDetails, ElementName=Root}">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Classes="Caption" Text="Student" Opacity="0"
                                               AutomationProperties.AccessibilityView="Raw" />
                                    <Border Classes="Skeleton" Width="64" Height="12"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Grid>
                                <Grid HorizontalAlignment="Left">
                                    <Button Classes="RecordLink" Content="Placeholder" Opacity="0"
                                            IsHitTestVisible="False" Focusable="False" IsTabStop="False"
                                            AutomationProperties.AccessibilityView="Raw" />
                                    <Border Classes="Skeleton" Width="160" Height="28"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="Card"
                                IsVisible="{Binding DataContext.LinkedStudent, ElementName=Root, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Student" Classes="Caption" />
                                <Button Classes="RecordLink" ToolTip.Tip="Open student"
                                        Content="{Binding DataContext.LinkedStudent.FullName, ElementName=Root}"
                                        Command="{Binding DataContext.NavigateToStudentCommand, ElementName=Root}"
                                        CommandParameter="{Binding DataContext.LinkedStudent, ElementName=Root}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="Card" IsVisible="{Binding DataContext.HasEmergencyContactLinks, ElementName=Root}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Emergency contact for" Classes="Caption" />
                                <!-- Same spacing as the Student card above: 4px under the heading and nothing
                                     extra below the last link (a per-item Margin="0,4" used to add 4px at both
                                     ends); links are spaced from each other by the panel instead. -->
                                <ItemsControl ItemsSource="{Binding DataContext.EmergencyContactForStudents, ElementName=Root}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="people:Student">
                                            <Button Classes="RecordLink" ToolTip.Tip="Open student"
                                                    Content="{Binding FullName}"
                                                    Command="{Binding DataContext.NavigateToStudentCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </controls:MasterDetailView.DetailTemplate>
        </controls:MasterDetailView>
    </Grid>

</reactiveui:ReactiveUserControl>
