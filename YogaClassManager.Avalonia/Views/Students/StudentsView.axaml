<reactiveui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YogaClassManager.Avalonia.ViewModels.Students"
             xmlns:people="using:YogaClassManager.Core.Models.People"
             xmlns:passes="using:YogaClassManager.Core.Models.Passes"
             xmlns:classes="using:YogaClassManager.Core.Models.Classes"
             xmlns:controls="using:YogaClassManager.Avalonia.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:behaviors="using:YogaClassManager.Avalonia.Behaviors"
             xmlns:localConv="using:YogaClassManager.Avalonia.Converters"
             xmlns:reactiveui="clr-namespace:Avalonia.ReactiveUI;assembly=Avalonia.ReactiveUI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="YogaClassManager.Avalonia.Views.Students.StudentsView"
             x:TypeArguments="vm:StudentsViewModel"
             x:Name="Root">

    <Grid RowDefinitions="Auto,*" Margin="{StaticResource PagePadding}">
        <TextBlock Grid.Row="0" Text="Students" Classes="PageTitle" Margin="0,0,0,16" />

        <controls:MasterDetailView Grid.Row="1" Items="{Binding Items}" SelectedItem="{Binding Selection}"
                                   IsBusy="{Binding IsBusy}" ErrorText="{Binding LastError}"
                                   EmptyText="No students match the current search and filters."
                                   NoSelectionText="Select a student to view their details.">
            <controls:MasterDetailView.ListHeader>
                <controls:FilterBar SearchQuery="{Binding SearchQuery, Mode=TwoWay}"
                                     SearchWatermark="Search by name..."
                                     SortOptions="{Binding SortByOptions}" SelectedSort="{Binding SortBy, Mode=TwoWay}"
                                     SortOrderOptions="{Binding SortOrderOptions}"
                                     SelectedSortOrder="{Binding SortOrder, Mode=TwoWay}"
                                     FilterCount="{Binding ActiveFilterCount}"
                                     ClearFiltersCommand="{Binding ClearFiltersCommand}">
                    <controls:FilterBar.AdvancedFilters>
                        <StackPanel Spacing="8" MinWidth="200">
                            <CheckBox Content="Show archived" IsChecked="{Binding IncludeArchived}" />
                            <controls:DateFilterField Label="Last attended from"
                                                       SelectedDate="{Binding LastAttendedFrom, Converter={x:Static localConv:DateOnlyToDateTimeConverter.Instance}}" />
                            <controls:DateFilterField Label="Last attended to"
                                                       SelectedDate="{Binding LastAttendedTo, Converter={x:Static localConv:DateOnlyToDateTimeConverter.Instance}}" />
                        </StackPanel>
                    </controls:FilterBar.AdvancedFilters>
                    <controls:FilterBar.Action>
                        <Button Command="{Binding AddStudentCommand}" Classes="accent Icon"
                                AutomationProperties.Name="Add student" ToolTip.Tip="Add student">
                            <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18" />
                        </Button>
                    </controls:FilterBar.Action>
                </controls:FilterBar>
            </controls:MasterDetailView.ListHeader>

            <controls:MasterDetailView.ListItemTemplate>
                <DataTemplate DataType="people:Student">
                    <controls:RecordListItem Title="{Binding FullName}" Subtitle="{Binding Email}"
                                             FlagLabel="ARCHIVED" IsFlagged="{Binding !IsActive}"
                                             FlagColor="{DynamicResource TagArchivedBrush}" />
                </DataTemplate>
            </controls:MasterDetailView.ListItemTemplate>

            <controls:MasterDetailView.DetailTemplate>
                <DataTemplate DataType="people:Student">
                    <ScrollViewer behaviors:ScrollEdgeShadow.IsEnabled="True">
                        <StackPanel Spacing="16">
                            <controls:RecordDetailsPanel Record="{Binding}">
                                <controls:RecordDetailsPanel.RecordTemplate>
                                    <DataTemplate DataType="people:Student">
                                        <StackPanel Spacing="{StaticResource SpacingXs}">
                                            <controls:DetailHeader Title="{Binding FullName}" PrimaryActionLabel="Edit" PrimaryActionIcon="Pencil"
                                                    PrimaryActionCommand="{Binding DataContext.EditStudentCommand, ElementName=Root}">
                                                <controls:DetailHeader.Actions>
                                                    <Button Classes="Overflow">
                                                        <Button.Flyout>
                                                            <controls:FadeMenuFlyout Placement="BottomEdgeAlignedRight">
                                                                <MenuItem Header="View identity record"
                                                                          Command="{Binding DataContext.ViewIdentityCommand, ElementName=Root}" />
                                                                <MenuItem Header="Archive" IsVisible="{Binding IsActive}"
                                                                          Command="{Binding DataContext.ToggleArchiveCommand, ElementName=Root}" />
                                                                <MenuItem Header="Unarchive" IsVisible="{Binding !IsActive}"
                                                                          Command="{Binding DataContext.ToggleArchiveCommand, ElementName=Root}" />
                                                            </controls:FadeMenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </controls:DetailHeader.Actions>
                                            </controls:DetailHeader>
                                            <!-- Missing phone/email shows a Muted "n/a" - same shape as IdentitiesView. -->
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                <TextBlock Text="Phone:" />
                                                <TextBlock Text="{Binding PhoneNumber}"
                                                           IsVisible="{Binding PhoneNumber, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                                <TextBlock Text="n/a" Classes="Muted"
                                                           IsVisible="{Binding PhoneNumber, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                <TextBlock Text="Email:" />
                                                <TextBlock Text="{Binding Email}"
                                                           IsVisible="{Binding Email, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                                <TextBlock Text="n/a" Classes="Muted"
                                                           IsVisible="{Binding Email, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                                            </StackPanel>
                                            <TextBlock Text="Archived" Foreground="{DynamicResource StatusArchivedBrush}"
                                                       IsVisible="{Binding !IsActive}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:RecordDetailsPanel.RecordTemplate>
                            </controls:RecordDetailsPanel>

                            <controls:FillWrapPanel Spacing="16">
                                <controls:LinkedRecordsPanel Header="Emergency contacts" SkeletonRows="1" controls:FillWrapPanel.WrapWidth="400" IsLoading="{Binding DataContext.IsLoadingDetails, ElementName=Root}"
                                    EmptyText="No emergency contacts recorded."
                                    ItemsSource="{Binding DataContext.EmergencyContacts, ElementName=Root}"
                                    AddCommand="{Binding DataContext.AddEmergencyContactCommand, ElementName=Root}"
                                    ViewLabel="View identity"
                                    ViewCommand="{Binding DataContext.ViewEmergencyContactCommand, ElementName=Root}"
                                    RemoveCommand="{Binding DataContext.RemoveEmergencyContactCommand, ElementName=Root}">
                                    <controls:LinkedRecordsPanel.ItemTemplate>
                                        <DataTemplate DataType="people:EmergencyContact">
                                            <!-- Same two-line shape as the Passes rows below: name +
                                                 relationship, then how to reach them underneath (mobile,
                                                 falling back to email - Identity requires at least one). -->
                                            <StackPanel Spacing="{StaticResource SpacingXs}">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                                    <TextBlock Text="{Binding FullName}"
                                                               FontWeight="{StaticResource FontWeightMedium}" />
                                                    <TextBlock Text="{Binding Relationship}" Classes="Muted" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding PhoneNumber}" Classes="Muted"
                                                           IsVisible="{Binding PhoneNumber, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                                <TextBlock Text="{Binding Email}" Classes="Muted"
                                                           IsVisible="{Binding PhoneNumber, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </controls:LinkedRecordsPanel.ItemTemplate>
                                </controls:LinkedRecordsPanel>

                                <controls:LinkedRecordsPanel Header="Health concerns" SkeletonRows="1" controls:FillWrapPanel.WrapWidth="400" IsLoading="{Binding DataContext.IsLoadingDetails, ElementName=Root}" SkeletonShowsSubtitle="False"
                                    EmptyText="No health concerns recorded."
                                    ItemsSource="{Binding DataContext.HealthConcerns, ElementName=Root}"
                                    AddCommand="{Binding DataContext.AddHealthConcernCommand, ElementName=Root}"
                                    EditCommand="{Binding DataContext.EditHealthConcernCommand, ElementName=Root}"
                                    RemoveCommand="{Binding DataContext.RemoveHealthConcernCommand, ElementName=Root}" />
                            </controls:FillWrapPanel>

                            <controls:LinkedRecordsPanel Header="Passes" SkeletonRows="1" IsLoading="{Binding DataContext.IsLoadingDetails, ElementName=Root}"
                                EmptyText="No passes match the current filters."
                                ItemsSource="{Binding DataContext.Passes, ElementName=Root}"
                                AddCommand="{Binding DataContext.AddPassCommand, ElementName=Root}"
                                ViewCommand="{Binding DataContext.ViewPassCommand, ElementName=Root}"
                                EditCommand="{Binding DataContext.EditPassCommand, ElementName=Root}"
                                RemoveCommand="{Binding DataContext.RemovePassCommand, ElementName=Root}"
                                FilterCount="{Binding DataContext.PassFilterCount, ElementName=Root}"
                                ClearFiltersCommand="{Binding DataContext.ClearPassFiltersCommand, ElementName=Root}">
                                <controls:LinkedRecordsPanel.Filters>
                                    <StackPanel Spacing="8" MinWidth="200">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Pass type" />
                                            <ComboBox ItemsSource="{Binding DataContext.PassKindFilterOptions, ElementName=Root}"
                                                      SelectedItem="{Binding DataContext.PassKindFilter, ElementName=Root, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                        <CheckBox Content="Include expired"
                                                  IsChecked="{Binding DataContext.IncludeExpiredPasses, ElementName=Root}" />
                                        <CheckBox Content="Include depleted"
                                                  IsChecked="{Binding DataContext.IncludeDepletedPasses, ElementName=Root}" />
                                    </StackPanel>
                                </controls:LinkedRecordsPanel.Filters>
                                <controls:LinkedRecordsPanel.ItemTemplate>
                                    <DataTemplate DataType="passes:Pass">
                                        <StackPanel Spacing="{StaticResource SpacingXs}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                                <TextBlock Text="{Binding PassName}"
                                                           FontWeight="{StaticResource FontWeightMedium}" />
                                                <TextBlock Text="{Binding ClassesRemaining, StringFormat='{}{0} remaining'}"
                                                           Classes="Muted" />
                                                <controls:Tag Color="{DynamicResource TagArchivedBrush}" Label="EXPIRED"
                                                              IsVisible="{Binding IsExpired}" />
                                                <controls:Tag Color="{DynamicResource TagWarningBrush}" Label="DEPLETED"
                                                              IsVisible="{Binding IsDepleted}" />
                                            </StackPanel>
                                            <!-- Subtype-specific detail (date range / term name / total class
                                                 count) - PassSecondLineTextConverter, not a display-string
                                                 property on the Pass model. Self-reference + IsNotNullOrEmpty
                                                 mirrors FilterButton's FilterCountText - hides the line rather
                                                 than showing empty when a subtype has nothing to add. -->
                                            <TextBlock x:Name="PassSecondLine" Classes="Muted"
                                                    Text="{Binding Converter={x:Static localConv:PassSecondLineTextConverter.Instance}}"
                                                    IsVisible="{Binding Text, ElementName=PassSecondLine, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:LinkedRecordsPanel.ItemTemplate>
                            </controls:LinkedRecordsPanel>

                            <controls:LinkedRecordsPanel Header="Classes attended" SkeletonRows="8" IsLoading="{Binding DataContext.IsLoadingDetails, ElementName=Root}"
                                EmptyText="No classes match the current filters."
                                ItemsSource="{Binding DataContext.AttendanceHistory, ElementName=Root}"
                                ViewCommand="{Binding DataContext.ViewClassCommand, ElementName=Root}"
                                SortOptions="{Binding DataContext.AttendanceSortByOptions, ElementName=Root}"
                                SelectedSort="{Binding DataContext.AttendanceSortBy, ElementName=Root, Mode=TwoWay}"
                                SortOrderOptions="{Binding DataContext.AttendanceSortOrderOptions, ElementName=Root}"
                                SelectedSortOrder="{Binding DataContext.AttendanceSortOrder, ElementName=Root, Mode=TwoWay}"
                                FilterCount="{Binding DataContext.AttendanceFilterCount, ElementName=Root}"
                                ClearFiltersCommand="{Binding DataContext.ClearAttendanceFiltersCommand, ElementName=Root}">
                                <!-- Same Date-from/Date-to/Day-of-week filters and Date/Time/DayOfWeek sort as
                                     Class Schedules' "Class rolls" list (ClassSchedulesView.axaml) - both go
                                     through ClassRollFilter/ClassRollSortOptions, so the two can't drift apart. -->
                                <controls:LinkedRecordsPanel.Filters>
                                    <StackPanel Spacing="8" MinWidth="200">
                                        <controls:DateFilterField Label="From"
                                                                   SelectedDate="{Binding DataContext.AttendanceDateFrom, ElementName=Root, Converter={x:Static localConv:DateOnlyToDateTimeConverter.Instance}}" />
                                        <controls:DateFilterField Label="To"
                                                                   SelectedDate="{Binding DataContext.AttendanceDateTo, ElementName=Root, Converter={x:Static localConv:DateOnlyToDateTimeConverter.Instance}}" />
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Day of week" />
                                            <ComboBox ItemsSource="{Binding DataContext.AttendanceDayOfWeekOptions, ElementName=Root}"
                                                      SelectedItem="{Binding DataContext.AttendanceDayOfWeek, ElementName=Root, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={x:Static localConv:NullableOptionTextConverter.Instance}}"
                                                                   Classes.Muted="{Binding Converter={x:Static conv:ObjectConverters.IsNull}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </controls:LinkedRecordsPanel.Filters>
                                <controls:LinkedRecordsPanel.ItemTemplate>
                                    <DataTemplate DataType="classes:ClassAttendanceRecord">
                                        <StackPanel Spacing="{StaticResource SpacingXs}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                                <TextBlock Text="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}" />
                                                <TextBlock Text="{Binding ClassSchedule}" Classes="Muted" />
                                            </StackPanel>
                                            <!-- PassUsedTextConverter folds in the date range/term name for
                                                 Dated/Term passes ("Dated Pass (start - end)") - PassName alone
                                                 doesn't distinguish which of a student's dated/term passes was
                                                 used for this class. -->
                                            <TextBlock Text="{Binding Pass, Converter={x:Static localConv:PassUsedTextConverter.Instance}}"
                                                       Classes="Muted" />
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:LinkedRecordsPanel.ItemTemplate>
                            </controls:LinkedRecordsPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DataTemplate>
            </controls:MasterDetailView.DetailTemplate>
        </controls:MasterDetailView>
    </Grid>

</reactiveui:ReactiveUserControl>
