<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:controls="using:YogaClassManager.Avalonia.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="320"
        x:Class="YogaClassManager.Avalonia.Views.Shared.ClassScheduleEditView"
        Width="360">

    <StackPanel Spacing="{StaticResource SpacingSm}">
        <TextBlock Text="{Binding Title}" Classes="DialogTitle" />

        <controls:FormField Label="Day">
            <ComboBox ItemsSource="{Binding DayOptions}" SelectedItem="{Binding Day}"
                      HorizontalAlignment="Stretch" />
        </controls:FormField>

        <controls:FormField Label="Time">
            <TimePicker SelectedTime="{Binding Time}" HorizontalAlignment="Stretch" />
        </controls:FormField>

        <CheckBox Content="Archived" IsChecked="{Binding IsArchived}"
                  Margin="{StaticResource GroupGapMargin}" />

        <TextBlock Text="{Binding ValidationError}" Classes="ValidationError"
                   IsVisible="{Binding ValidationError, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />

        <controls:DialogButtonRow ConfirmLabel="Save" />
    </StackPanel>

</UserControl>
