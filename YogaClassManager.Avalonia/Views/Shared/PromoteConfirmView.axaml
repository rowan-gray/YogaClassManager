<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:YogaClassManager.Avalonia.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="280"
        x:Class="YogaClassManager.Avalonia.Views.Shared.PromoteConfirmView"
        Width="440">

    <StackPanel Spacing="{StaticResource SpacingSm}">
        <TextBlock Text="Possible existing identity" Classes="DialogTitle" />
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />

        <controls:DialogButtonRow ConfirmLabel="Use existing" CancelLabel="Create new instead" />
    </StackPanel>

</UserControl>
